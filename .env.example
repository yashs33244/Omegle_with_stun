# Environment for docker-compose.yml (copy to .env next to it).
# In production the deploy workflow writes this file from GitHub secrets
# (see DEPLOYMENT.md for the secret behind each variable).
# Empty values mean "use the default" (for backend variables: the default in
# backend/src/config.ts).

# ---- Images -------------------------------------------------------------
# Local builds are tagged chizzy-backend / chizzy-frontend. The deploy workflow
# sets the Docker Hub names and the commit sha tag.
BACKEND_IMAGE=chizzy-backend
FRONTEND_IMAGE=chizzy-frontend
IMAGE_TAG=latest

# ---- Ports and exposure -------------------------------------------------
# Host ports for the gateway (socket server and REST API) and the static frontend.
BACKEND_PORT=3004
FRONTEND_PORT=5173
# 127.0.0.1 keeps both ports reachable only from this host (the TLS host
# proxy in front of them); it is also the only setup in which the gateway's
# X-Forwarded-For trust is safe. 0.0.0.0 listens on every interface.
BIND_ADDRESS=127.0.0.1

# ---- Backend ------------------------------------------------------------
# Number of backend replicas behind the gateway.
BACKEND_REPLICAS=2
# Comma separated list of allowed browser origins. Required in production,
# "*" is rejected there.
CORS_ORIGINS=http://localhost:5173
# Optional Redis password (URL safe, e.g. `openssl rand -hex 32`). Redis is
# only reachable on the internal compose network either way.
REDIS_PASSWORD=
MAX_CONNECTIONS_PER_IP=10
# New socket connections per client IP on each replica: a burst, then a
# steady rate per second. Empty: backend defaults (20, 1). Raise both for
# load tests, where every virtual user comes from one address.
CONNECT_BURST_PER_IP=
CONNECT_RATE_PER_IP_PER_SEC=
MATCH_ACCEPT_TIMEOUT_MS=30000
LOG_LEVEL=info
# If set, GET /metrics on a replica requires `Authorization: Bearer <token>`.
# The gateway never exposes /metrics publicly.
METRICS_TOKEN=
SHUTDOWN_GRACE_MS=10000

# ---- Session gate (POST /api/session) -----------------------------------
# HMAC key for session and age tokens. Required in production (at least 32
# characters; the backend refuses to start without it). Generate with
# `openssl rand -hex 32`. To rotate: move the old value to
# SESSION_SECRET_PREVIOUS, set a new SESSION_SECRET, deploy, and clear
# SESSION_SECRET_PREVIOUS after the longest token lifetime (180 days for age
# tokens, see docs/retention.md).
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=
# Cloudflare Turnstile. Required in production: both keys, or
# TURNSTILE_DISABLED=true. The same secret verifies the session gate and the
# takedown form. For local testing use Cloudflare's public test keys:
# site key 1x00000000000000000000AA with secret
# 1x0000000000000000000000000000000AA (always passes), or secret
# 2x0000000000000000000000000000000AA (always fails). Never use the test keys
# in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# true skips Turnstile verification. Only for load tests and local stacks.
TURNSTILE_DISABLED=false
# true when Cloudflare proxies the API hostname: the backend then reads the
# country (CF-IPCountry) for the blocklist. Leave false otherwise; the
# country is unknown then and the blocklist cannot apply (DEPLOYMENT.md).
TRUST_CLOUDFLARE=false
# Requests to POST /api/session per minute, per client IP and per /24 (IPv6
# /48) network, and matches per hour per IP and per device. Empty: backend
# defaults (10, 60, 200, 200). Raise them for e2e and load tests, where every
# client shares one address.
SESSION_RATE_PER_IP_PER_MIN=
SESSION_RATE_PER_NETWORK_PER_MIN=
MATCH_CAP_PER_DEVICE_PER_HOUR=
MATCH_CAP_PER_IP_PER_HOUR=

# ---- ICE servers (WebRTC) -----------------------------------------------
# cloudflare: per-call credentials from Cloudflare Realtime TURN (production).
# static or secret: the TURN_URLS settings below. Empty: backend default.
TURN_PROVIDER=
# Cloudflare Realtime TURN key (Dashboard -> Realtime -> TURN).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Account id and a read-only Analytics API token, used by the TURN spend
# poller that steps down bitrate, Hide my IP and then TURN when egress grows.
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
# Defaults to Google's public STUN servers when empty.
STUN_URLS=
# Self-hosted TURN only (TURN_PROVIDER static or secret). coturn is NOT part
# of this stack; run it on a separate host if you need it (README).
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
# Lifetime of issued TURN credentials in seconds (empty: backend default).
TURN_TTL_SECONDS=
# Per-device TURN credential cache in seconds, and how many credential sets a
# device and an IP may get per hour. Empty: backend defaults (300, 20, 100).
TURN_CACHE_SECONDS=
TURN_MAX_PER_DEVICE_HOUR=
TURN_MAX_PER_IP_HOUR=
# Daily Cloudflare TURN egress thresholds in GB for the spend poller: lower
# the relay bitrate, then turn off Hide my IP, then turn off TURN.
# Empty: 35,50,70.
TURN_SPEND_DAILY_GB=

# ---- Observability (all optional, all public values) -------------------
# Sentry DSN for the backend, and the one the frontend reads from /api/config.
SENTRY_DSN=
SENTRY_DSN_FRONTEND=
# PostHog project key and host (https://us.i.posthog.com or https://eu.i.posthog.com).
POSTHOG_KEY=
POSTHOG_HOST=

# ---- Admin console (/admin, API under /admin/api/*) ---------------------
# Bearer token for the admin API. Required in production (at least 24
# characters; the backend refuses to start without it). Generate with
# `openssl rand -hex 32`. Put Cloudflare Access in front of /admin/api/ too.
ADMIN_TOKEN=
# Optional comma list of client IPs allowed to call the admin API (exact match, no CIDRs).
ADMIN_ALLOWED_IPS=
# Salt for the pseudonymous device ids the admin console shows (at least 16
# characters, `openssl rand -hex 32`). Empty: derived from ADMIN_TOKEN, so
# every pseudonym changes when the token is rotated. Set it once, before the
# first report, and never change it.
PSEUDONYM_SALT=

# ---- Evidence store ----------------------------------------------------
# Empty: evidence is kept on the evidence-data volume (/data/evidence).
# Set a bucket to use S3 instead; the backend gets AWS credentials from the
# EC2 instance role (raise the IMDSv2 hop limit to 2 for containers).
# EVIDENCE_S3_REGION is required with a bucket (for example ap-south-1);
# EVIDENCE_S3_KMS_KEY_ID encrypts objects with that KMS key (SSE-KMS);
# empty uses SSE-S3.
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=
EVIDENCE_S3_KMS_KEY_ID=

# ---- Billing (coin packs through Razorpay) ------------------------------
# Live key pair and the webhook secret (Dashboard -> Webhooks, URL
# https://<api host>/api/billing/webhook). Empty keeps /api/billing orders
# off. The backend refuses to start with keys but no webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Host operations (read by deploy/ and scripts/, not by containers) --
# true: deploy/deploy.sh refreshes the Cloudflare IP list and makes the
# gateway refuse requests that did not come through Cloudflare (DEPLOYMENT.md).
CLOUDFLARE_ONLY=false
# s3://bucket/prefix for scripts/backup-redis.sh. Empty: keep local copies only.
BACKUP_S3_URI=

# ---- Frontend build -----------------------------------------------------
# Public URL of the gateway, baked into the SPA at build time. The frontend
# CSP connect-src is derived from it.
VITE_API_URL=http://localhost:3004
# Public URL of the site itself, baked into the SPA at build time: canonical
# and link preview (og:url, og:image) URLs, sitemap.xml and robots.txt.
VITE_SITE_URL=http://localhost:5173
