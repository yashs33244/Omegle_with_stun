# Environment for docker-compose.yml (copy to .env next to it).
# In production the deploy workflow writes this file from GitHub secrets.
# Empty values mean "use the default".

# ---- Images -------------------------------------------------------------
# Local builds are tagged chizzy-backend / chizzy-frontend. The deploy workflow
# sets the Docker Hub names and the commit sha tag.
BACKEND_IMAGE=chizzy-backend
FRONTEND_IMAGE=chizzy-frontend
IMAGE_TAG=latest

# ---- Ports and exposure -------------------------------------------------
# Host ports for the gateway (socket server) and the static frontend.
BACKEND_PORT=3004
FRONTEND_PORT=5173
# 0.0.0.0 listens on every interface. Use 127.0.0.1 when a host proxy (TLS) is
# in front, so nobody can reach the containers around it.
BIND_ADDRESS=0.0.0.0

# ---- Backend ------------------------------------------------------------
# Number of backend replicas behind the gateway.
BACKEND_REPLICAS=2
# Comma separated list of allowed browser origins. Required in production,
# "*" is rejected there.
CORS_ORIGINS=http://localhost:5173
# Optional Redis password (URL safe, e.g. `openssl rand -hex 32`). Redis is
# only reachable on the internal compose network either way.
REDIS_PASSWORD=
MAX_CONNECTIONS_PER_IP=10
MATCH_ACCEPT_TIMEOUT_MS=30000
LOG_LEVEL=info
# If set, GET /metrics on a replica requires `Authorization: Bearer <token>`.
# The gateway never exposes /metrics publicly.
METRICS_TOKEN=
SHUTDOWN_GRACE_MS=10000

# ---- ICE servers (WebRTC) -----------------------------------------------
# Defaults to Google's public STUN servers when empty.
STUN_URLS=
# TURN relay, e.g. turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
# Shared secret with coturn (use-auth-secret). The backend issues short-lived
# HMAC credentials. Generate with `openssl rand -hex 32`.
TURN_SECRET=
# Static alternative to TURN_SECRET (both must be set together).
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=43200

# ---- Optional coturn service (docker compose --profile turn up -d) -------
TURN_REALM=chizzy
# On EC2 use "<public-ip>/<private-ip>".
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ---- Frontend build -----------------------------------------------------
# Public URL of the gateway, baked into the SPA at build time.
VITE_API_URL=http://localhost:3004
