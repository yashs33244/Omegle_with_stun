# Socket.IO origin of the backend, read at build time by Vite.
# When unset, dev builds use http://localhost:3004 and production builds
# use https://chizzyapi.itsyash.space.
VITE_API_URL=http://localhost:3004
# Public origin of the site, used for the canonical and link preview URLs,
# sitemap.xml and robots.txt. Defaults to https://chizzy.itsyash.space.
VITE_SITE_URL=http://localhost:8080
