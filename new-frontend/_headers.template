# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# scripts/write-headers.mjs renders this into dist/_headers after `vite build`,
# replacing ${CSP_CONNECT_SRC} with 'self' plus the VITE_API_URL origin over
# https and wss, the same way nginx-api-origin.envsh does for the nginx image.
# The header set must match vercel.json and nginx-security-headers.conf;
# scripts/check-frontend-headers.sh fails CI when the three drift. Why each
# third-party origin is allowed is explained in nginx-security-headers.conf.
# Pages matches every rule whose pattern fits the request, so /models/* and
# /admin* get the /* headers plus their own. Each line must stay under 2000
# characters and the file under 100 rules.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://checkout.razorpay.com 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src ${CSP_CONNECT_SRC} https://challenges.cloudflare.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://us.i.posthog.com https://eu.i.posthog.com https://api.razorpay.com https://checkout.razorpay.com https://lumberjack.razorpay.com; frame-src https://challenges.cloudflare.com https://api.razorpay.com https://checkout.razorpay.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(), geolocation=(), payment=(self "https://api.razorpay.com" "https://checkout.razorpay.com"), usb=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Vite emits content-hashed file names under /assets/.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted moderation models and wasm runtimes (public/models/). A new
# model version must use a new path, never overwrite a file.
/models/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

# Admin console: a lazy chunk of the same SPA, not for search engines.
/admin*
  X-Robots-Tag: noindex, nofollow
