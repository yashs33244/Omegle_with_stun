    {
      "id": "travel-03",
      "topics": [
        "travel"
      ],
      "text": "कौन से शहर में आप कल ही शिफ़्ट हो जाएँगे?"
    },
    {
      "id": "travel-04",
      "topics": [
        "travel"
      ],
      "text": "लंबे सफ़र के लिए ट्रेन, बस या हवाई जहाज़?"
    },
    {
      "id": "travel-05",
      "topics": [
        "travel"
      ],
      "text": "आप जहाँ रहते हैं, वहाँ की सबसे अच्छी बात क्या है?"
    },
    {
      "id": "travel-06",
      "topics": [
        "travel"
      ],
      "text": "ऐसी एक जगह जहाँ हर किसी को एक बार ज़रूर जाना चाहिए?"
    },
    {
      "id": "travel-07",
      "topics": [
        "travel"
      ],
      "text": "आप हल्का सामान ले जाते हैं या सब कुछ ठूँस लेते हैं?"
    },
    {
      "id": "travel-08",
      "topics": [
        "travel"
      ],
      "text": "अकेले की यात्रा या दोस्तों के साथ?"
