    {
      "id": "books-03",
      "topics": [
        "books"
      ],
      "text": "कागज़ की किताब, ई-बुक या ऑडियोबुक?"
    },
    {
      "id": "books-04",
      "topics": [
        "books"
      ],
      "text": "किस काल्पनिक किरदार से आप दोस्ती करना चाहेंगे?"
    },
    {
      "id": "books-05",
      "topics": [
        "books"
      ],
      "text": "ऐसी कौन सी किताब है जो हर किसी को 30 से पहले पढ़नी चाहिए?"
    },
    {
      "id": "books-06",
      "topics": [
        "books"
      ],
      "text": "क्या आपने कभी एक बैठक में पूरी किताब खत्म की है?"
    },
    {
      "id": "books-07",
      "topics": [
        "books",
        "movies"
      ],
      "text": "कौन सी किताब अपनी फ़िल्म से बेहतर थी?"
    },
    {
      "id": "books-08",
      "topics": [
        "books"
      ],
      "text": "किसी किताब की आपकी पसंदीदा पहली पंक्ति कौन सी है?"
    },
    {
      "id": "books-09",
      "topics": [
        "books"
      ],
      "text": "अगर आप किताब लिखें, तो उसका नाम क्या होगा?"
    },
    {
      "id": "books-10",
      "topics": [
        "books"
      ],
      "text": "कॉमिक्स भी किताबें हैं। सहमत या असहमत?"
    },
    {
      "id": "books-11",
      "topics": [
        "books"
      ],
      "text": "किस लेखक से आप मिलना चाहेंगे?"
    },
    {
      "id": "books-12",
      "topics": [
        "books"
      ],
      "text": "आखिरी किताब जिसने आपको हँसाया?"
    },
    {
      "id": "books-13",
      "topics": [
        "books"
      ],
      "text": "क्या आप पहले अंत पढ़ लेते हैं? सच बताइए।"
    },
    {
      "id": "books-14",
      "topics": [
        "books"
      ],
      "text": "कौन सी किताब आप किसी अजनबी को देना चाहेंगे?"
    },
    {
      "id": "books-15",
      "topics": [
        "books"
      ],
      "text": "कविता या गद्य?"
    },
    {
      "id": "books-16",
      "topics": [
        "books"
      ],
      "text": "बचपन की कौन सी कहानी आपको आज भी याद है?"
