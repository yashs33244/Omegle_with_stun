        "technology"
      ],
      "text": "आपका पहला फ़ोन कौन सा था?"
    },
    {
      "id": "technology-05",
      "topics": [
        "technology"
      ],
      "text": "डार्क मोड या लाइट मोड?"
    },
    {
      "id": "technology-06",
      "topics": [
        "technology"
      ],
      "text": "कौन सी तकनीक आप चाहते हैं कि कभी बनी ही न होती?"
    },
    {
      "id": "technology-07",
      "topics": [
        "technology"
      ],
      "text": "क्या आप मंगल ग्रह की एकतरफ़ा यात्रा पर जाएँगे?"
    },
    {
      "id": "technology-08",
      "topics": [
        "technology"
      ],
      "text": "अभी आपके पास कितने अनपढ़े नोटिफ़िकेशन हैं?"
    },
    {
      "id": "technology-09",
      "topics": [
        "technology"
      ],
      "text": "कौन सा टेक स्किल आपने खुद से सीखा?"
    },
    {
      "id": "technology-10",
      "topics": [
        "technology"
      ],
      "text": "आप एक हफ़्ते बिना इंटरनेट रहना चाहेंगे या बिना फ़ोन?"
    },
    {
      "id": "technology-11",
      "topics": [
        "technology"
      ],
      "text": "सबसे पुराना गैजेट कौन सा है जो आप आज भी इस्तेमाल करते हैं?"
    },
    {
      "id": "technology-12",
      "topics": [
        "technology"
      ],
      "text": "घर के काम रोबोट करें: हाँ या ना?"
    },
    {
      "id": "technology-13",
      "topics": [
        "technology"
      ],
      "text": "इस हफ़्ते आपका स्क्रीन टाइम कैसा चल रहा है?"
    },
    {
      "id": "technology-14",
      "topics": [
        "technology"
      ],
      "text": "अगर आप कोई भी ऐप बना सकें, तो वो क्या करेगा?"
    },
    {
      "id": "technology-15",
      "topics": [
        "technology",
        "music"
      ],
      "text": "वायर वाले हेडफ़ोन या वायरलेस?"
    },
    {
      "id": "technology-16",
      "topics": [
        "technology"
      ],
      "text": "इस महीने इंटरनेट पर आपको सबसे अच्छी चीज़ क्या मिली?"
    },
    {
      "id": "art-01",
      "topics": [
        "art"
      ],
      "text": "क्या आप ड्रॉइंग, पेंटिंग या कुछ बनाते हैं?"
    },
    {
      "id": "art-02",
      "topics": [
        "art"
      ],
      "text": "इस हफ़्ते आपने सबसे सुंदर चीज़ क्या देखी?"
    },
    {
      "id": "art-03",
      "topics": [
        "art"
      ],
      "text": "आज आपके मूड को कौन सा रंग बयान करता है?"
    },
    {
      "id": "art-04",
      "topics": [
        "art"
      ],
      "text": "स्ट्रीट आर्ट या म्यूज़ियम की कला?"
    },
    {
      "id": "art-05",
      "topics": [
        "art"
      ],
      "text": "अगर आप कोई एक मशहूर पेंटिंग रख सकें, तो कौन सी?"
