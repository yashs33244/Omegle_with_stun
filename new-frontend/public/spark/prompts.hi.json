    {
      "id": "art-06",
      "topics": [
        "art"
      ],
      "text": "कौन सी हस्तकला आप सीखना चाहेंगे?"
    },
    {
      "id": "art-07",
      "topics": [
        "art"
      ],
      "text": "हवा में कुछ बनाइए, देखें पहचान में आता है या नहीं!"
    },
    {
      "id": "art-08",
      "topics": [
        "art"
      ],
      "text": "आपकी खींची हुई सबसे पसंदीदा फ़ोटो कौन सी है?"
    },
    {
      "id": "art-09",
      "topics": [
        "art"
      ],
      "text": "क्या आप कॉल या मीटिंग के दौरान डूडल बनाते हैं?"
    },
    {
      "id": "art-10",
      "topics": [
        "art",
        "travel"
      ],
      "text": "आपके शहर की सबसे सुंदर इमारत कौन सी है?"
    },
    {
      "id": "art-11",
      "topics": [
        "art"
      ],
      "text": "पेंसिल, पेंट या पिक्सल?"
    },
    {
      "id": "art-12",
      "topics": [
        "art"
      ],
      "text": "कौन सी कलाकृति आपके ज़हन में बस गई?"
    },
    {
      "id": "art-13",
      "topics": [
        "art"
      ],
      "text": "अगर आप एक टैटू डिज़ाइन करें, तो क्या बनाएँगे?"
    },
    {
      "id": "art-14",
      "topics": [
        "art",
        "technology"
      ],
      "text": "आपका पसंदीदा फ़ॉन्ट कौन सा है? हाँ, ऐसा भी होता है।"
    },
    {
      "id": "art-15",
      "topics": [
        "art"
      ],
      "text": "कौन सा मौसम आप सबसे पहले पेंट करेंगे?"
    },
    {
      "id": "art-16",
      "topics": [
        "art"
      ],
      "text": "अपने पास की कोई हाथ से बनी चीज़ दिखाइए।"
    },
    {
      "id": "travel-01",
      "topics": [
        "travel"
      ],
      "text": "आपकी पिछली यात्रा कहाँ थी, और सबसे अच्छी बात क्या थी?"
    },
    {
      "id": "travel-02",
      "topics": [
        "travel"
      ],
      "text": "खिड़की वाली सीट या गलियारे वाली?"
