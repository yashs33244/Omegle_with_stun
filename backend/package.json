{
  "name": "chizzy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Chizzy signaling and matchmaking server (Express 5 + Socket.IO; runs on Node 22, built and tested with Bun)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "test:redis": "TEST_STORE=redis bun test",
    "test:node": "node --test \"test-node/*.mjs\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@sentry/node": "^11.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.1",
    "socket.io-adapter": "~2.5.5",
    "socket.io-parser": "~4.2.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/bun": "^1.2.17",
    "@types/express": "^5.0.3",
    "eslint": "^9.30.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1"
  }
}
