# Chizzy backend configuration. Copy to .env and adjust.
# Every variable is optional except CORS_ORIGINS in production.
# Parsed and validated in src/config.ts; the server refuses to start on bad values.

# development | production | test
NODE_ENV=development

# HTTP and Socket.IO port.
PORT=3004

# Comma separated list of allowed browser origins (scheme://host[:port], no path).
# REQUIRED in production, and "*" is rejected there. Defaults to "*" otherwise.
CORS_ORIGINS=http://localhost:5173

# Set to use Redis for shared state (needed for more than one replica).
# Example: redis://:password@redis:6379/0
REDIS_URL=

# true when running behind our gateway: the client IP is read from X-Real-IP.
# Leave false when clients connect directly, or anyone can spoof their IP.
TRUST_PROXY=false

# Socket.IO connections allowed per client IP on this instance.
MAX_CONNECTIONS_PER_IP=10

# How long both users have to accept a match, in milliseconds.
MATCH_ACCEPT_TIMEOUT_MS=30000

# Comma separated STUN URLs handed to clients.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN relay. Comma separated, e.g.
# turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
# coturn `use-auth-secret` shared secret. Clients get short lived credentials:
# username = <expiry>:<deviceId>, credential = base64(HMAC-SHA1(secret, username)).
TURN_SECRET=
# Static TURN credentials, only if TURN_SECRET is not used. Set both or neither.
TURN_USERNAME=
TURN_CREDENTIAL=
# Lifetime of issued TURN credentials, in seconds.
TURN_TTL_SECONDS=43200

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# If set, GET /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=

# Max time to drain on SIGTERM/SIGINT before forcing exit, in milliseconds.
SHUTDOWN_GRACE_MS=10000
