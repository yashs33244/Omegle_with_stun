# Chizzy backend configuration. Copy to .env and adjust.
# Every variable is optional except CORS_ORIGINS in production.
# Parsed and validated in src/config.ts; the server refuses to start on bad values.

# development | production | test
NODE_ENV=development

# HTTP and Socket.IO port.
PORT=3004

# Comma separated list of allowed browser origins (scheme://host[:port], no path).
# REQUIRED in production, and "*" is rejected there. Defaults to "*" otherwise.
# 8080 is the Vite dev server (npm run dev), 5173 the frontend container.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Set to use Redis for shared state (needed for more than one replica).
# Example: redis://:password@redis:6379/0
REDIS_URL=

# true when running behind our gateway: the client IP is read from X-Real-IP.
# Leave false when clients connect directly, or anyone can spoof their IP.
TRUST_PROXY=false

# Socket.IO connections allowed per client IP on this instance.
MAX_CONNECTIONS_PER_IP=10

# How long both users have to accept a match, in milliseconds.
MATCH_ACCEPT_TIMEOUT_MS=30000

# Comma separated STUN URLs handed to clients.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN provider for per-call relay credentials (sent only in call:start, never at hello):
#   cloudflare  Cloudflare Realtime TURN (needs CF_TURN_KEY_ID and CF_TURN_API_TOKEN)
#   secret      self-hosted coturn with use-auth-secret (needs TURN_URLS and TURN_SECRET)
#   static      fixed TURN_USERNAME / TURN_CREDENTIAL (needs TURN_URLS)
#   none        STUN only
# Empty: secret if TURN_SECRET is set, static if TURN_USERNAME is set, else none.
TURN_PROVIDER=
# Cloudflare TURN key id and API token (Realtime > TURN in the dashboard).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# One credential set per device is reused for this long, in seconds.
TURN_CACHE_SECONDS=300
# New credential sets per device and per client IP per hour; above it calls get STUN only.
TURN_MAX_PER_DEVICE_HOUR=20
TURN_MAX_PER_IP_HOUR=100

# TURN spend poller: reads today's TURN egress from Cloudflare analytics every 15 minutes.
# Set both to enable (token needs Account Analytics read).
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
# Daily GB thresholds (UTC day) for the three step-downs: relay bitrate to 300 kbps,
# then Hide my IP off, then TURN off. Steps stay until an operator resets the flags.
TURN_SPEND_DAILY_GB=35,50,70

# Self-hosted TURN relay (providers secret and static). Comma separated, e.g.
# turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
# coturn `use-auth-secret` shared secret. Clients get short lived credentials:
# username = <expiry>:<deviceId>, credential = base64(HMAC-SHA1(secret, username)).
TURN_SECRET=
# Static TURN credentials, only if TURN_SECRET is not used. Set both or neither.
TURN_USERNAME=
TURN_CREDENTIAL=
# Lifetime of issued TURN credentials, in seconds (Cloudflare and secret providers).
TURN_TTL_SECONDS=7200

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# If set, GET /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=

# Max time to drain on SIGTERM/SIGINT before forcing exit, in milliseconds.
SHUTDOWN_GRACE_MS=10000

# ---- Session gate (POST /api/session, Socket.IO handshake) ----

# Signs session tokens (24 h) and age tokens (180 days), and salts the hashes
# kept for under-18 lockouts and rate limits. REQUIRED in production, at least
# 32 characters (openssl rand -hex 32). Every replica must share it. When unset
# outside production a random key is used and tokens die with the process.
SESSION_SECRET=
# The previous SESSION_SECRET during a rotation: still accepted for
# verification (and lockout lookups) while new tokens use SESSION_SECRET.
SESSION_SECRET_PREVIOUS=

# Cloudflare Turnstile. The secret is REQUIRED in production unless
# TURNSTILE_DISABLED=true (which logs a loud warning: no bot protection).
# The site key is public and is served to clients by GET /api/config.
# The same widget guards the public takedown form: without a secret, production
# refuses takedown submissions and development accepts them.
# Test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_DISABLED=false

# true only when BOTH the site and this API are proxied by Cloudflare and the
# origin accepts Cloudflare IPs only. Then CF-IPCountry is trusted for the
# country blocklist (flag blocked_countries). Otherwise the country is unknown
# and geo-blocking is OFF (a warning is logged at startup).
TRUST_CLOUDFLARE=false

# POST /api/session requests allowed per minute per IP, and per /24 (IPv6 /48).
SESSION_RATE_PER_IP_PER_MIN=10
SESSION_RATE_PER_NETWORK_PER_MIN=60

# Matches allowed per hour per device and per IP; over the cap the client is
# told to try later. Set high enough that no human reaches it.
MATCH_CAP_PER_DEVICE_PER_HOUR=200
MATCH_CAP_PER_IP_PER_HOUR=200

# ---- Observability ----

# Backend Sentry DSN. Empty disables Sentry. Events are scrubbed (no bodies,
# headers, query strings, users or breadcrumb payloads).
SENTRY_DSN=
# Public values served to the browser by GET /api/config.
SENTRY_DSN_FRONTEND=
POSTHOG_KEY=
POSTHOG_HOST=
# --- Enforcement (reports, admin API, evidence) ---

# Bearer token for /admin/api (at least 24 characters). REQUIRED in production;
# without it the admin API answers 503. Generate a long random value.
ADMIN_TOKEN=
# Optional comma separated client IPs allowed to call /admin/api (exact match).
# X-Real-IP is used only when TRUST_PROXY=true. Also put Cloudflare Access in front.
ADMIN_ALLOWED_IPS=
# Directory for report evidence frames when no S3 bucket is set. Created with 0700;
# must be writable by the server user (mount a volume in Docker).
EVIDENCE_DIR=./data/evidence
# Store evidence in S3 instead (server-side encrypted). Credentials come from the
# standard AWS environment. Restricted (suspected CSAM) items go under restricted/.
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=
# Optional KMS key for SSE-KMS; without it objects use SSE-S3 (AES256).
EVIDENCE_S3_KMS_KEY_ID=
# Salt for the pseudonymous device ids admins see (16+ characters). Defaults to
# one derived from ADMIN_TOKEN; set it so rotating the token keeps ids stable.
PSEUDONYM_SALT=
